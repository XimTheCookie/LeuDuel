  "behaviour-settings": {
    "title": "Behaviour Settings",
    "counter-reset": {
      "title": "Counter reset",
      "label": {
        "never": "Never",
        "game": "Game",
        "match": "Match"
      },
      "info": "<ul><li><b>Never</b>: counters are never reset automatically.</li><li><b>Game</b>: counters reset whenever LP are reset.</li><li><b>Match</b>: counters reset at the start or end of a match.</li></ul>"
    },
    "game-reset": {
      "title": "Game reset",
      "label": {
        "manual": "Manual",
        "lp-zero": "LP Zero",
        "lp-zero-auto": "LP Zero (auto)"
      },
      "info": "Defines when the LP reset modal is displayed.<ul><li><b>Manual</b>: The modal only opens when triggered explicitly.</li><li><b>LP Zero</b>: The modal opens automatically when any player's LP reaches zero.</li><li><b>LP Zero (auto)</b>: Same as above, but the modal is auto-confirmed without opening, resetting LP immediately.</li></ul>"
    },
    "winner-selection": {
      "title": "Winner selection",
      "label": {
        "manual": "Manual",
        "auto": "Auto"
      },
      "info": "Defines how the winner is assigned in the LP reset modal.<ul><li><b>Manual</b>: The winner is selected by the user.</li><li><b>Auto</b>: The winner is suggested automatically. If <i>Game Reset</i> is also set to <i>LP Zero (auto)</i>, the winner is picked and confirmed without any interaction.</li></ul>"
    },
    "match-stop": {
      "title": "Match stop",
      "label": {
        "manual": "Manual",
        "winner-found": "Winner found"
      },
      "info": "Defines when the match stop.<ul><li><b>Manual</b>: Match stop prompt opens when triggered explicitly.</li><li><b>Winner found</b>: Match stop prompt opens when a winner is found.</li></ul>"
    },
    "on-startup": {
      "title": "On startup",
      "label": {
        "restore": "Restore game",
        "reset": "Reset game"
      },
      "info": "Defines what happens when the app starts.<ul><li><b>Restore game</b>: If any game was in progress, its restored.</li><li><b>Reset game</b>: Game is reset.</li></ul>"
    }
  },
